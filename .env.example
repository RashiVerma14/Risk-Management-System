# ================================================================
# RISKMANAGER PLATFORM ENVIRONMENT CONFIGURATION
# Copy to .env and provide your actual credentials
# ================================================================

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# MongoDB
MONGODB_URI=mongodb://localhost:27017/riskmanager

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Security & JWT (HMAC-SHA256 Secret, at least 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# AI Provider (Groq or any OpenAI-compatible API)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Notifications (Slack & Email)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_FROM=alerts@riskmanager.io
